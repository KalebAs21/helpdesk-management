generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICAL
  EMPLOYEE
}

enum Department {
  IT
  ELECTRICAL
  GENERAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Category {
  IT_SUPPORT
  ELECTRICAL_SUPPORT
  FACILITIES
  HR
  OTHER
}

enum ActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role
  department Department? @default(IT)

  createdTickets  Ticket[]   @relation("TicketCreator")
  assignedTickets Ticket[]   @relation("TicketAssignee")
  comments        Comment[]
  activities      Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  title        String
  description  String
  category     Category
  priority     Priority
  status       TicketStatus @default(OPEN)
  department   Department?  @default(IT)

  createdById  String
  assignedToId String?

  createdBy  User       @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?      @relation("TicketAssignee", fields: [assignedToId], references: [id])
  comments   Comment[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String

  ticketId String
  userId   String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Activity {
  id     String       @id @default(cuid())
  type   ActivityType
  detail String

  ticketId String
  userId   String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}